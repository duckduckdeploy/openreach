# With Docker (docker compose up -d --build) you only need AUTH_SECRET and ENCRYPTION_KEY below;
# the database is set up for you. On a server with a domain, also set the Docker section at the end.

# Postgres (development from source; Docker sets its own). Two databases: accounts, keys and
# billing in DATABASE_URL; project data (creators, leads, monitors) in its own.
DATABASE_URL=postgres://localhost:5432/openreach
# Unset: the same server with "_data" added to the name (openreach_data), created on first migrate.
# DATA_DATABASE_URL=postgres://localhost:5432/openreach_data

# API
API_PORT=4300
API_URL=http://localhost:4300
APP_URL=http://localhost:3300
WEB_URL=http://localhost:3301

# 32+ random characters. Signs sessions.
AUTH_SECRET=change-me-to-a-long-random-string
# 32 bytes, base64. Encrypts stored YepAPI keys. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: override the YepAPI base URL (tests, proxies)
YEPAPI_BASE_URL=https://api.yepapi.com

# Proxies in front of the API whose X-Forwarded-For is trusted. Leave 0 unless every request
# passes proxies you control that overwrite it.
TRUST_PROXY_HOPS=0
# A header your edge proxy sets to the visitor's address, e.g. cf-connecting-ip. Used by sign-in rate limits.
# CLIENT_IP_HEADER=

# Optional: free tools on the website that anyone can run without an account, paid from this
# YepAPI key. Capped per month, per day and per visitor (runs a day).
# PUBLIC_TOOLS_YEPAPI_KEY=
# PUBLIC_TOOLS_MONTHLY_USD=30
# PUBLIC_TOOLS_DAILY_USD=2
# PUBLIC_TOOLS_PER_DAY=5

# Lead searches per user: how many run at once, and the most Maps calls one search may make.
# LEAD_SEARCH_MAX_ACTIVE_PER_USER=2
# LEAD_SEARCH_MAX_CALLS=500

# Optional: free community APIs, searched from this server. All work without keys at lower limits.
# GitHub: a token with no scopes raises issue-search limits.
# GITHUB_TOKEN=
# Stack Exchange: an app key from stackapps.com raises the daily quota from 300 to 10,000.
# STACKEXCHANGE_KEY=
# Reddit: an app from reddit.com/prefs/apps, used with application-only OAuth. Without it,
# Reddit is searched through Google results (YepAPI).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Docker on a server with a domain: docker compose --profile https up -d --build
# OPENREACH_DOMAIN=example.com
# APP_URL=https://app.example.com
# WEB_URL=https://example.com
# PUBLIC_API_URL=https://api.example.com
# POSTGRES_PASSWORD=a-long-random-password
