{
  "name": "openreach",
  "private": true,
  "version": "0.1.0",
  "description": "OpenReach: the open-source customer, lead and influencer finder. Self-host it with Docker or use it at openreach.gg.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @openreach/api dev",
    "dev:app": "pnpm --filter @openreach/app dev",
    "dev:web": "pnpm --filter @openreach/web dev",
    "db:generate": "pnpm --filter @openreach/api db:generate",
    "db:migrate": "pnpm --filter @openreach/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}