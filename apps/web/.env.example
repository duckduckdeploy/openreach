# Where the OpenReach app lives. "Get started" and "Sign in" link to
# ${NEXT_PUBLIC_APP_URL}/sign-up and /sign-in.
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Public URL of this site. Used for canonical URLs, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://openreach.gg

# Optional. GitHub links are only rendered when this is set.
NEXT_PUBLIC_GITHUB_URL=

# Public address of the API. Agents connect to it at /mcp. Set before build.
NEXT_PUBLIC_API_URL=http://localhost:4300

